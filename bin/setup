#!/usr/bin/env bash
set -euo pipefail

# setup — bootstrap agent-skills on a new machine.
# Links skills into harness directories and links opencode config.
#
# Usage:
#   bin/setup                    # link all skills + config to opencode
#   bin/setup --agent claude     # link to Claude Code instead (no config linking)
#   bin/setup --all              # link all plugins to all harnesses
#   bin/setup --plugin coding    # link only a specific plugin

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

AGENT="${AGENT:-opencode}"
LINK_ALL=false
PLUGINS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent) AGENT="$2"; shift 2 ;;
    --all) LINK_ALL=true; shift ;;
    --plugin) PLUGINS+=("$2"); shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

echo "=== agent-skills setup ==="
echo "  repo:    $REPO_ROOT"
echo "  agent:   $AGENT"
echo ""

# --- Link opencode config ----------------------------------------------

if [[ "$AGENT" == "opencode" ]] || $LINK_ALL; then
  OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
  mkdir -p "$OPENCODE_CONFIG_DIR"

  echo "installing opencode config..."

  # opencode.jsonc: copy (not symlink) so corti models init can write model specs
  # into the live config without dirtying the repo. Model specs are generated at
  # install time via `corti models init` — never committed.
  opencode_source="$REPO_ROOT/config/opencode.jsonc"
  opencode_target="$OPENCODE_CONFIG_DIR/opencode.jsonc"
  if [[ -e "$opencode_target" && ! -L "$opencode_target" ]]; then
    echo "  backing up existing opencode.jsonc -> opencode.jsonc.bak"
    mv "$opencode_target" "$opencode_target.bak"
  elif [[ -L "$opencode_target" ]]; then
    rm "$opencode_target"
  fi
  cp "$opencode_source" "$opencode_target"
  echo "  copied opencode.jsonc"

  # Generate model specs via corti CLI
  if command -v npx &>/dev/null; then
    echo "  running corti models init..."
    npx @corti/cli@latest models init \
      --tools opencode --scope global --yes --no-shell-rc \
      --model corti-s1,corti-s1-instant,corti-s1-mini,corti-s1-mini-instant,corti-s1-beta,corti-s1-embedding,corti-s1-ultra-beta,corti-s1-tiny,corti-s1-tiny-instant \
      2>&1 | sed 's/^/    /'
  else
    echo "  WARNING: npx not found — skipping model init. Models will be bare stubs."
  fi

  # tui.json and tui-preferences.jsonc: symlink (no generated content)
  for cfg_file in config/tui.json config/tui-preferences.jsonc; do
    source="$REPO_ROOT/$cfg_file"
    target="$OPENCODE_CONFIG_DIR/$(basename "$cfg_file")"
    if [[ -e "$target" && ! -L "$target" ]]; then
      echo "  backing up existing $(basename "$cfg_file") -> $(basename "$cfg_file").bak"
      mv "$target" "$target.bak"
    fi
    ln -sf "$source" "$target"
    echo "  linked $(basename "$cfg_file")"
  done

  # Link agents directory (e.g. title.md for session naming)
  if [[ -d "$REPO_ROOT/agents" ]]; then
    agents_target="$OPENCODE_CONFIG_DIR/agents"
    ln -sfh "$REPO_ROOT/agents" "$agents_target" 2>/dev/null || {
      [[ -e "$agents_target" && ! -L "$agents_target" ]] && mv "$agents_target" "$agents_target.bak"
      ln -sf "$REPO_ROOT/agents" "$agents_target"
    }
    echo "  linked agents/"
  fi

  echo ""
  echo "Required env vars:"
  echo "  CORTI_BEARER          Corti API key"
  echo "  SLACK_CLIENT_ID       Slack MCP OAuth client ID"
  echo "  SLACK_CLIENT_SECRET   Slack MCP OAuth client secret"
  echo ""
fi

# --- Link skills -------------------------------------------------------

if $LINK_ALL; then
  echo "linking all plugins to all harnesses..."
  for a in claude codex opencode cursor; do
    python3 "$SCRIPT_DIR/skillctl" link --agent "$a" --force || true
  done
elif [[ ${#PLUGINS[@]} -gt 0 ]]; then
  for p in "${PLUGINS[@]}"; do
    python3 "$SCRIPT_DIR/skillctl" link --plugin "$p" --agent "$AGENT" --force
  done
else
  python3 "$SCRIPT_DIR/skillctl" link --agent "$AGENT" --force
fi

echo ""
echo "=== done ==="
echo "run 'skillctl doctor' to verify, 'skillctl list' to see available skills."
