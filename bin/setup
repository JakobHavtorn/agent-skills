#!/usr/bin/env bash
set -euo pipefail

# setup — link agent-skills into harness directories.
# Config management is handled by the dotfiles repo (chezmoi), not here.
#
# Usage:
#   bin/setup                    # link all skills to opencode
#   bin/setup --agent claude     # link to Claude Code instead
#   bin/setup --all              # link all plugins to all harnesses
#   bin/setup --plugin coding    # link only a specific plugin

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

AGENT="${AGENT:-opencode}"
LINK_ALL=false
PLUGINS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent) AGENT="$2"; shift 2 ;;
    --all) LINK_ALL=true; shift ;;
    --plugin) PLUGINS+=("$2"); shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

echo "=== agent-skills setup ==="
echo "  repo:    $REPO_ROOT"
echo "  agent:   $AGENT"
echo ""

# --- Link skills -------------------------------------------------------

if $LINK_ALL; then
  echo "linking all plugins to all harnesses..."
  for a in claude codex opencode cursor omp; do
    python3 "$SCRIPT_DIR/skillctl" link --agent "$a" --force || true
  done
elif [[ ${#PLUGINS[@]} -gt 0 ]]; then
  for p in "${PLUGINS[@]}"; do
    python3 "$SCRIPT_DIR/skillctl" link --plugin "$p" --agent "$AGENT" --force
  done
else
  python3 "$SCRIPT_DIR/skillctl" link --agent "$AGENT" --force
fi

echo ""
echo "=== done ==="
echo "run 'skillctl doctor' to verify, 'skillctl list' to see available skills."
