#!/usr/bin/env python3
"""skillctl — install, link, test, and diagnose agent skills.

Clone-on-one, link-many: symlinks skill directories from this repo into
harness-specific target paths so a single `git pull` updates every harness.

Usage:
  skillctl link --plugin coding  --agent claude
  skillctl link --agent opencode
  skillctl unlink --plugin coding --agent claude
  skillctl prune --agent opencode
  skillctl prune --agent omp --apply
  skillctl doctor
  skillctl list
  skillctl test
  skillctl test --skill open-pr
  skillctl test --runner claude --model claude-sonnet-4-20250514
"""

import argparse
import json
import os
import platform
import re
import shutil
import stat
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
PLUGINS_DIR = REPO_ROOT / "plugins"

C_BLUE = "\033[34m"
C_GREEN = "\033[32m"
C_RED = "\033[31m"
C_RESET = "\033[0m"

# Harness target paths (spec §7 — verify against client docs at implementation time)
# omp: verified empirically via `omp skill list --json` — sources native:user
# (~/.omp/agent/skills) and native:project (.omp/skills)


@dataclass
class ScopePaths:
    """Paths for one harness in one scope."""
    skills: Path              # where SKILL.md dirs get symlinked
    context: Path | None = None  # where AGENTS.md gets symlinked (user scope only)


@dataclass
class HarnessPaths:
    """Per-harness paths for both user and project scope."""
    user: ScopePaths
    project: ScopePaths


HARNESS_PATHS: dict[str, HarnessPaths] = {
    "claude": HarnessPaths(
        user=ScopePaths(Path.home() / ".claude" / "skills", Path.home() / ".claude"),
        project=ScopePaths(Path.cwd() / ".claude" / "skills"),
    ),
    "codex": HarnessPaths(
        user=ScopePaths(Path.home() / ".codex" / "skills", Path.home() / ".codex"),
        project=ScopePaths(Path.cwd() / ".agents" / "skills"),
    ),
    "opencode": HarnessPaths(
        user=ScopePaths(Path.home() / ".config" / "opencode" / "skills", Path.home() / ".config" / "opencode"),
        project=ScopePaths(Path.cwd() / ".opencode" / "skills"),
    ),
    "cursor": HarnessPaths(
        user=ScopePaths(Path.home() / ".cursor" / "skills", Path.home() / ".cursor"),
        project=ScopePaths(Path.cwd() / ".cursor" / "skills"),
    ),
    "omp": HarnessPaths(
        user=ScopePaths(Path.home() / ".omp" / "agent" / "skills", Path.home() / ".omp"),
        project=ScopePaths(Path.cwd() / ".omp" / "skills"),
    ),
}

# Shared context file — linked as AGENTS.md into each harness's top-level config dir.
# Contains high-level agent working rules (worktree policy, verification, etc.).
# Lives alongside per-harness files like ~/.claude/CLAUDE.md without replacing them.
CONTEXT_FILE = REPO_ROOT / "global" / "AGENTS.md"
CONTEXT_TARGET_NAME = "AGENTS.md"

# On Windows, Git defaults to core.symlinks=false — symlinks become dead text files.
FORCE_COPY = platform.system() == "Windows" or os.environ.get("SKILLCTL_FORCE_COPY", "")


def get_plugin_skills(plugin_name: str) -> list[Path]:
    """Return list of skill directories for a plugin."""
    skills_dir = PLUGINS_DIR / plugin_name / "skills"
    if not skills_dir.is_dir():
        return []
    return sorted(d for d in skills_dir.iterdir() if d.is_dir() and (d / "SKILL.md").exists())


def get_all_skills() -> dict[str, list[Path]]:
    """Return {plugin_name: [skill_dirs]} for all plugins."""
    result = {}
    if not PLUGINS_DIR.is_dir():
        return result
    for plugin_dir in sorted(PLUGINS_DIR.iterdir()):
        if plugin_dir.is_dir() and (plugin_dir / "plugin.json").exists():
            skills = get_plugin_skills(plugin_dir.name)
            if skills:
                result[plugin_dir.name] = skills
    return result

class SkillctlError(Exception):
    """Error in skillctl that should print to stderr and exit(1)."""


def get_target_dir(agent: str, scope: str) -> Path:
    """Resolve the target directory for a given harness and scope."""
    if agent not in HARNESS_PATHS:
        raise SkillctlError(f"unknown agent '{agent}'. Choose from: {', '.join(HARNESS_PATHS)}")
    if scope not in ("user", "project"):
        raise SkillctlError(f"scope must be 'user' or 'project', got '{scope}'")
    return getattr(HARNESS_PATHS[agent], scope).skills


def _link_entry(source: Path, target: Path, copy_fn, force: bool) -> str:
    """Shared link-or-copy logic for one filesystem entry.

    When *copy_fn* is None the entry is symlinked; otherwise *copy_fn* is
    the callable used to copy (shutil.copytree for directories, shutil.copy2
    for files).  Returns 'linked', 'copied', or 'exists'.  Raises
    SkillctlError on a conflict that cannot be resolved (target exists,
    not a matching symlink, and force=False).
    """
    name = target.name

    if target.exists() or target.is_symlink():
        if target.is_symlink() and target.resolve() == source.resolve():
            return "exists"
        if not force:
            if target.is_symlink():
                actual = target.resolve()
                print(f"  SKIP {name}: target exists, points to {actual}", file=sys.stderr)
            else:
                print(f"  SKIP {name}: target exists and is not a symlink", file=sys.stderr)
            raise SkillctlError(f"cannot link {name}: target exists")
        if target.is_symlink():
            target.unlink()
        else:
            shutil.rmtree(target)
        print(f"  OVERWRITE {name} (replaced existing target)", file=sys.stderr)

    if copy_fn is not None:
        copy_fn(source, target)
        return "copied"
    os.symlink(source, target)
    return "linked"


def link_skill(skill_dir: Path, target_dir: Path, copy: bool = False, force: bool = False) -> str:
    """Link or copy a single skill into target_dir. Returns 'linked', 'copied', or 'exists'."""
    copy_fn = shutil.copytree if (copy or FORCE_COPY) else None
    return _link_entry(skill_dir, target_dir / skill_dir.name, copy_fn, force)


def link_context_file(agent: str, scope: str, copy: bool = False, force: bool = False) -> str:
    """Link global/AGENTS.md into the harness config dir. Returns 'linked', 'copied', 'exists', or 'error'."""
    if not CONTEXT_FILE.exists():
        return "error"

    target_dir = getattr(HARNESS_PATHS[agent], scope).context
    target_dir.mkdir(parents=True, exist_ok=True)
    copy_fn = shutil.copy2 if (copy or FORCE_COPY) else None
    return _link_entry(CONTEXT_FILE, target_dir / CONTEXT_TARGET_NAME, copy_fn, force)


def unlink_context_file(agent: str, scope: str) -> bool:
    """Remove the AGENTS.md symlink from the harness config dir. Returns True if removed."""
    link_path = getattr(HARNESS_PATHS[agent], scope).context / CONTEXT_TARGET_NAME
    if link_path.is_symlink():
        link_path.unlink()
        return True
    elif link_path.exists():
        print(f"  SKIP {CONTEXT_TARGET_NAME}: not a symlink, leaving in place", file=sys.stderr)
        return False
    return False
def resolve_plugins(args) -> dict[str, list[Path]]:
    """Resolve the plugin→skills map from args.

    If args.plugin is set, return just that plugin (error if it has no
    skills).  Otherwise return all plugins (error if none found).
    """
    if args.plugin:
        skills = get_plugin_skills(args.plugin)
        if not skills:
            raise SkillctlError(f"no skills found in plugin '{args.plugin}'")
        return {args.plugin: skills}
    plugins = get_all_skills()
    if not plugins:
        raise SkillctlError("no plugins or skills found")
    return plugins

def cmd_link(args):
    """Link all skills from a plugin into a harness target directory."""
    target_dir = get_target_dir(args.agent, args.scope)
    target_dir.mkdir(parents=True, exist_ok=True)
    plugins = resolve_plugins(args)

    linked = 0
    copied = 0
    exists = 0
    errors = 0
    for plugin_name, skills in plugins.items():
        for skill_dir in skills:
            try:
                result = link_skill(skill_dir, target_dir, copy=args.copy, force=args.force)
            except SkillctlError:
                errors += 1
                continue
            if result == "linked":
                print(f"  LINKED {skill_dir.name} -> {target_dir / skill_dir.name}")
                linked += 1
            elif result == "copied":
                print(f"  COPIED {skill_dir.name} -> {target_dir / skill_dir.name}")
                copied += 1
            elif result == "exists":
                print(f"  EXISTS {skill_dir.name} (already linked)")
                exists += 1

    print(f"\nDone: {linked} linked, {copied} copied, {exists} already existed, {errors} skipped")

    # Link the shared context file (user scope only).
    if args.scope == "user" and CONTEXT_FILE.exists():
        result = link_context_file(args.agent, args.scope, copy=args.copy, force=args.force)
        ctx_dir = getattr(HARNESS_PATHS[args.agent], args.scope).context
        if result == "linked":
            print(f"  LINKED {CONTEXT_TARGET_NAME} -> {ctx_dir / CONTEXT_TARGET_NAME}")
        elif result == "copied":
            print(f"  COPIED {CONTEXT_TARGET_NAME} -> {ctx_dir / CONTEXT_TARGET_NAME}")
        elif result == "exists":
            print(f"  EXISTS {CONTEXT_TARGET_NAME} (already linked)")
        else:
            print(f"  SKIP {CONTEXT_TARGET_NAME} (see warnings above)", file=sys.stderr)


def cmd_unlink(args):
    """Remove symlinks for a plugin's skills from a harness target directory."""
    target_dir = get_target_dir(args.agent, args.scope)
    plugins = resolve_plugins(args)

    removed = 0
    for plugin_name, skills in plugins.items():
        for skill_dir in skills:
            link_path = target_dir / skill_dir.name
            if link_path.is_symlink():
                link_path.unlink()
                print(f"  REMOVED {skill_dir.name}")
                removed += 1
            elif link_path.exists():
                print(f"  SKIP {skill_dir.name}: not a symlink, leaving in place", file=sys.stderr)
            else:
                print(f"  ABSENT {skill_dir.name}")

    print(f"\nDone: {removed} removed")

    # Unlink the shared context file (user scope only).
    if args.scope == "user":
        if unlink_context_file(args.agent, args.scope):
            print(f"  REMOVED {CONTEXT_TARGET_NAME}")


def cmd_doctor(args):
    """Report what is linked where, plus orphans and broken links."""
    print("=== skillctl doctor ===\n")
    all_skills = get_all_skills()
    if not all_skills:
        print("No plugins or skills found.")
        return

    for plugin_name, skill_dirs in all_skills.items():
        print(f"Plugin: {plugin_name}")
        for skill_dir in skill_dirs:
            print(f"  {skill_dir.name}")

    print()
    for agent, harness in HARNESS_PATHS.items():
        for scope_name in ("user", "project"):
            target = getattr(harness, scope_name).skills
            if not target.exists():
                continue
            print(f"=== {agent} ({scope_name}) -> {target} ===")
            for entry in sorted(target.iterdir()):
                if entry.is_symlink():
                    resolved = entry.resolve()
                    if resolved.exists():
                        print(f"  {entry.name} -> {resolved}  [OK]")
                    else:
                        print(f"  {entry.name} -> {resolved}  [BROKEN]")
                elif entry.is_dir():
                    # Could be a copy or an orphan
                    has_skill = (entry / "SKILL.md").exists()
                    tag = "copy" if has_skill else "orphan"
                    print(f"  {entry.name}  [{tag}]")
                else:
                    print(f"  {entry.name}  [unknown]")
    # Report context file link status.
    if CONTEXT_FILE.exists():
        print(f"=== Context file: {CONTEXT_FILE.relative_to(REPO_ROOT)} ===")
        for agent in HARNESS_PATHS:
            ctx_dir = HARNESS_PATHS[agent].user.context
            link_path = ctx_dir / CONTEXT_TARGET_NAME
            if link_path.is_symlink():
                resolved = link_path.resolve()
                status = "[OK]" if resolved.exists() else "[BROKEN]"
                print(f"  {agent:<10} {link_path} -> {resolved}  {status}")
            elif link_path.exists():
                print(f"  {agent:<10} {link_path}  [not a symlink]")
            else:
                print(f"  {agent:<10} {link_path}  [absent]")
        print()

def _classify_target_entry(entry: Path, skill_root: Path, declared_names: set[str]) -> tuple[str, str]:
    """Classify one entry of a harness target directory for maintenance.

    Returns (cls, detail). cls is one of:
      alive            symlink resolving to an existing target inside the source repo
      foreign-alive    symlink resolving to an existing target outside the source repo
      stale            symlink dangling, with target path inside the source repo —
                       the linked skill was deleted or moved by a repo update
      foreign-dangling symlink dangling with target outside the source repo
      copy             real directory with SKILL.md whose name is a declared skill
      orphan           real directory with SKILL.md whose name is not declared
      stray            anything else (dirs without SKILL.md, plain files)
    """
    if entry.is_symlink():
        try:
            resolved = entry.resolve(strict=False)
        except (OSError, RuntimeError):
            return "stray", "unresolvable symlink"
        if resolved.exists():
            if resolved.is_relative_to(skill_root):
                return "alive", str(resolved)
            return "foreign-alive", str(resolved)
        if resolved.is_relative_to(skill_root):
            return "stale", str(resolved)
        return "foreign-dangling", str(resolved)
    if entry.is_dir():
        if (entry / "SKILL.md").exists():
            if entry.name in declared_names:
                return "copy", "live copy of a declared skill"
            return "orphan", "copy of a skill no longer in the source"
        return "stray", "directory without SKILL.md"
    return "stray", "file"


def cmd_prune(args):
    """Remove dangling links to deleted skills. Dry run unless --apply."""
    target_dir = get_target_dir(args.agent, args.scope)
    if not target_dir.exists():
        print(f"Nothing to prune: {target_dir} does not exist")
        return

    declared: set[str] = set()
    for skill_dirs in get_all_skills().values():
        declared.update(s.name for s in skill_dirs)

    counts = {"alive": 0, "stale": 0, "foreign-alive": 0, "foreign-dangling": 0, "copy": 0,
              "orphan": 0, "stray": 0}
    pruned = 0
    would_prune = 0

    for entry in sorted(target_dir.iterdir()):
        cls, detail = _classify_target_entry(entry, REPO_ROOT, declared)
        counts[cls] = counts.get(cls, 0) + 1

        if cls == "stale":
            if args.apply:
                print(f"  PRUNED {entry.name} -> {detail} (target gone)")
                entry.unlink()
                pruned += 1
            else:
                print(f"  STALE {entry.name} -> {detail} (target gone; dry run — pass --apply)")
                would_prune += 1
        elif cls == "orphan":
            if args.orphans and args.apply:
                print(f"  PRUNED {entry.name} ({detail})")
                shutil.rmtree(entry)
                pruned += 1
            elif args.orphans:
                print(f"  ORPHAN {entry.name} ({detail}; dry run — pass --apply)")
                would_prune += 1
            else:
                print(f"  ORPHAN {entry.name} ({detail}) — pass --orphans to prune")
        elif cls in ("foreign-alive", "foreign-dangling"):
            print(f"  FOREIGN {entry.name} -> {detail} (not managed by this repo, leaving)")
        elif cls == "copy":
            print(f"  KEEP {entry.name} ({detail})")
        elif cls == "alive":
            print(f"  KEEP {entry.name} -> {detail}")
        else:
            print(f"  KEEP {entry.name} (stray: {detail})")

    counts_parts = (
        f"{pruned} pruned" if args.apply else f"{would_prune} would be pruned",
        f"{counts['alive']} alive",
        f"{counts['copy']} copies",
        f"{counts['orphan']} orphans",
        f"{counts['foreign-alive'] + counts['foreign-dangling']} foreign",
        f"{counts['stray']} stray",
    )
    print("\nDone: " + ", ".join(counts_parts))


def cmd_list(args):
    """List all plugins and their skills."""
    all_skills = get_all_skills()
    if not all_skills:
        print("No plugins or skills found.")
        return

    for plugin_name, skill_dirs in all_skills.items():
        print(f"{plugin_name}/")
        for skill_dir in skill_dirs:
            print(f"  {skill_dir.name}/")


def cmd_list_agents(args):
    """Print supported agent/harness names, one per line."""
    for agent in HARNESS_PATHS:
        print(agent)


# ---------------------------------------------------------------------------
# skillctl test — trigger detection testing
# ---------------------------------------------------------------------------

TESTS_DIR = REPO_ROOT / "tests"

def _opencode_args(prompt: str, model: str | None) -> list[str]:
    args = ["run", "--format", "json"]
    if model:
        args += ["-m", model]
    args.append(prompt)
    return args


def _claude_args(prompt: str, model: str | None) -> list[str]:
    args = ["--print"]
    if model:
        args += ["--model", model]
    args.append(prompt)

def _omp_args(prompt: str, model: str | None) -> list[str]:
    args = ["-p", "--mode", "json"]
    if model:
        args += ["--model", model]
    args.append(prompt)
    return args

RUNNERS = {
    "opencode": {
        "cmd": "opencode",
        "args_fn": _opencode_args,
        "extract": lambda output: _extract_opencode_text(output),
    },
    "claude": {
        "cmd": "claude",
        "args_fn": _claude_args,
        "extract": lambda output: output,
    },
    "omp": {
        "cmd": "omp",
        "args_fn": _omp_args,
        "extract": lambda output: _extract_omp_text(output),
    },
}


def collect_skill_descriptions() -> list[dict]:
    """Collect {name, description} from all SKILL.md files in the repo."""
    import yaml

    skills = []
    if not PLUGINS_DIR.is_dir():
        return skills
    for plugin_dir in sorted(PLUGINS_DIR.iterdir()):
        if not plugin_dir.is_dir() or not (plugin_dir / "plugin.json").exists():
            continue
        skills_dir = plugin_dir / "skills"
        if not skills_dir.is_dir():
            continue
        for skill_dir in sorted(skills_dir.iterdir()):
            skill_md = skill_dir / "SKILL.md"
            if not skill_md.exists():
                continue
            content = skill_md.read_text()
            m = re.match(r"^---\n(.*?\n)---", content, re.DOTALL)
            if not m:
                continue
            try:
                fm = yaml.safe_load(m.group(1))
            except Exception:
                continue
            if not isinstance(fm, dict):
                continue
            name = fm.get("name", skill_dir.name)
            desc = fm.get("description", "")
            if isinstance(desc, str):
                desc = " ".join(desc.split())
            skills.append({"name": name, "description": desc or ""})
    return skills


def build_classification_prompt(skills: list[dict], user_message: str) -> str:
    """Build the prompt that asks the LLM which skill(s) to activate."""
    lines = [
        "You are an AI agent with the following skills available:",
        "",
    ]
    for i, s in enumerate(skills, 1):
        lines.append(f"{i}. {s['name']}: {s['description']}")
    lines.append("")
    lines.append(
        "Which skill(s) should be activated for the user message below? "
        "Reply with ONLY skill names, one per line. "
        'If none apply, reply "none".'
    )
    lines.append("")
    lines.append(f"User message: \"{user_message}\"")
    return "\n".join(lines)


def _extract_opencode_text(json_output: str) -> str:
    """Extract assistant text from opencode run --format json output (NDJSON)."""
    text_parts = []
    for line in json_output.strip().splitlines():
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "text":
            part = event.get("part", {})
            if isinstance(part, dict) and part.get("text"):
                text_parts.append(part["text"])
    return "\n".join(text_parts)


def _extract_omp_text(json_output: str) -> str:
    """Extract assistant text from omp --mode json output (NDJSON).

    OMP is a Pi fork and emits the same NDJSON event schema.  Completed
    messages arrive in ``message_end`` events whose ``content`` field
    holds the full text.
    """
    text_parts = []
    for line in json_output.strip().splitlines():
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "message_end":
            content = event.get("content")
            if isinstance(content, str) and content:
                text_parts.append(content)
            elif isinstance(content, list):
                for part in content:
                    if isinstance(part, dict) and part.get("text"):
                        text_parts.append(part["text"])
                    elif isinstance(part, str):
                        text_parts.append(part)
    return "\n".join(text_parts)


def run_runner(runner: str, prompt: str, model: str | None) -> tuple[str, str]:
    """Execute the LLM runner and return (text_output, model_identifier)."""
    if runner not in RUNNERS:
        raise SkillctlError(f"unknown runner '{runner}'. Choose from: {', '.join(RUNNERS)}")

    cfg = RUNNERS[runner]
    cmd = cfg["cmd"]
    args = cfg["args_fn"](prompt, model)

    if not shutil.which(cmd):
        raise SkillctlError(f"'{cmd}' not found on PATH")

    try:
        proc = subprocess.run(
            [cmd] + args,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except subprocess.TimeoutExpired:
        return "", model or ""

    output = proc.stdout if proc.returncode == 0 else proc.stderr
    text = cfg["extract"](output)
    return text, model or cmd


def parse_skill_names(response: str, known_skills: list[dict]) -> set[str]:
    """Parse the LLM response into a set of matched skill names."""
    known_names = {s["name"] for s in known_skills}
    matched = set()
    for line in response.strip().splitlines():
        name = line.strip().strip("-").strip()
        if name.lower() == "none":
            continue
        if name in known_names:
            matched.add(name)
    return matched


def load_cases(skill_name: str) -> dict | None:
    """Load tests/<skill_name>/cases.json."""
    cases_file = TESTS_DIR / skill_name / "cases.json"
    if not cases_file.exists():
        return None
    try:
        return json.loads(cases_file.read_text())
    except json.JSONDecodeError as e:
        print(f"error: invalid JSON in {cases_file}: {e}", file=sys.stderr)
        return None


def find_test_skills() -> list[str]:
    """Return skill names that have tests/*/cases.json."""
    if not TESTS_DIR.is_dir():
        return []
    return sorted(
        d.name for d in TESTS_DIR.iterdir()
        if d.is_dir() and (d / "cases.json").exists()
    )


def execute_case(runner: str, model: str | None, skills: list[dict],
                 skill_name: str, case_type: str, prompt: str, index: int) -> dict:
    """Run a single trigger-detection case and return a result dict."""
    classification_prompt = build_classification_prompt(skills, prompt)
    response, model_id = run_runner(runner, classification_prompt, model)
    matched = parse_skill_names(response, skills)
    triggered = skill_name in matched
    passed = triggered if case_type == "should_trigger" else not triggered
    return {
        "skill": skill_name,
        "type": case_type,
        "prompt": prompt,
        "index": index,
        "expected": case_type == "should_trigger",
        "actual": triggered,
        "passed": passed,
        "matched_skills": sorted(matched),
    }


class ProgressRenderer:
    """Encapsulates ANSI cursor math for test progress display."""

    def __init__(self, total: int):
        self.total = total

    def update(self, completed: int):
        """Print the progress line."""
        print(f"\r\033[2K{C_BLUE}  {completed}/{self.total} cases complete...{C_RESET}",
              end="", flush=True)

    def flush_block(self, block_lines: int):
        """Insert blank lines before a skill block."""
        print(f"\r\033[{block_lines}L", end="", flush=True)

    def clear(self):
        """Clear the progress line."""
        print(f"\r\033[2K")

    def interrupt(self, completed: int):
        """Print interruption message."""
        print(f"\r\033[2K{C_RED}\n  Interrupted at {completed}/{self.total} cases — cancelling...{C_RESET}",
              file=sys.stderr)


class NullProgressRenderer:
    """No-op renderer for testing/non-interactive use."""

    def __init__(self, total: int):
        self.total = total

    def update(self, completed: int):
        pass

    def flush_block(self, block_lines: int):
        pass

    def clear(self):
        pass

    def interrupt(self, completed: int):
        pass


def _count_block_lines(raw_results: list[dict], args) -> int:
    """Count lines _flush_skill_block will print for these results."""
    cases_sorted = sorted(raw_results,
                          key=lambda r: (r["type"] != "should_trigger", r["index"]))
    case_lines = sum(1 for r in cases_sorted if args.verbose or not r["passed"])
    summary_line = 0 if args.verbose else 1
    return 5 + case_lines + summary_line


def _flush_skill_block(skill_name: str, raw_results: list[dict], args,
                       total_pass: int, total_fail: int, results_all: list):
    """Print a skill's test block and write results.json.

    Returns updated (total_pass, total_fail).
    """
    cases_sorted = sorted(raw_results,
                          key=lambda r: (r["type"] != "should_trigger", r["index"]))

    print(f"\n{'=' * 60}")
    print(f"Testing: {skill_name}")
    print(f"{'=' * 60}")

    case_results = []
    for r in cases_sorted:
        case_results.append({
            "type": r["type"], "prompt": r["prompt"],
            "expected": r["expected"], "actual": r["actual"],
            "passed": r["passed"], "matched_skills": r["matched_skills"],
        })
        if r["passed"]:
            total_pass += 1
        else:
            total_fail += 1
        if args.verbose or not r["passed"]:
            status = f"{C_GREEN}PASS{C_RESET}" if r["passed"] else f"{C_RED}FAIL{C_RESET}"
            label = "trigger" if r["type"] == "should_trigger" else "no-trig"
            extra = f" (got: {', '.join(r['matched_skills']) or 'none'})" if not r["passed"] else ""
            print(f"  [{status}] {label}  {r['prompt']}{extra}")

    if not args.verbose:
        skill_pass = sum(1 for c in case_results if c["passed"])
        print(f"  {skill_pass}/{len(case_results)} passed")

    result_obj = {
        "skill": skill_name,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "model": args.model or args.runner,
        "runner": args.runner,
        "summary": {
            "passed": sum(1 for c in case_results if c["passed"]),
            "failed": sum(1 for c in case_results if not c["passed"]),
            "total": len(case_results),
        },
        "cases": case_results,
    }
    results_all.append(result_obj)

    results_file = TESTS_DIR / skill_name / "results.json"
    results_file.write_text(json.dumps(result_obj, indent=2, ensure_ascii=False) + "\n")

    return total_pass, total_fail


def cmd_test(args):
    """Run trigger detection tests for skills."""
    skills = collect_skill_descriptions()
    if not skills:
        raise SkillctlError("no skills found in plugins/")

    skill_names = find_test_skills()
    if not skill_names:
        raise SkillctlError("no tests/*/cases.json found")

    if args.skill:
        if args.skill not in skill_names:
            raise SkillctlError(f"no tests/{args.skill}/cases.json found")
        skill_names = [args.skill]

    all_jobs = []
    for skill_name in skill_names:
        cases = load_cases(skill_name)
        if cases is None:
            print(f"  SKIP {skill_name}: no cases.json", file=sys.stderr)
            continue
        should_trigger = cases.get("should_trigger", [])
        should_not_trigger = cases.get("should_not_trigger", [])
        for i, prompt in enumerate(should_trigger):
            all_jobs.append((skill_name, "should_trigger", prompt, i))
        for i, prompt in enumerate(should_not_trigger):
            all_jobs.append((skill_name, "should_not_trigger", prompt, i))

    if not all_jobs:
        raise SkillctlError("no test cases found")

    remaining = {}
    for job in all_jobs:
        remaining[job[0]] = remaining.get(job[0], 0) + 1
    skill_results = {name: [] for name in remaining}

    total_cases = len(all_jobs)
    completed = 0
    total_pass = 0
    total_fail = 0
    results_all = []
    renderer = ProgressRenderer(total_cases)

    renderer.update(0)

    executor = ThreadPoolExecutor(max_workers=args.jobs)
    futures = {
        executor.submit(execute_case, args.runner, args.model,
                        skills, job[0], job[1], job[2], job[3]): job
        for job in all_jobs
    }

    try:
        for future in as_completed(futures):
            try:
                result = future.result()
            except Exception:
                job = futures[future]
                result = {
                    "skill": job[0], "type": job[1], "prompt": job[2],
                    "index": job[3], "expected": job[1] == "should_trigger",
                    "actual": False, "passed": False, "matched_skills": [],
                }

            skill_name = result["skill"]
            skill_results[skill_name].append(result)
            remaining[skill_name] -= 1
            completed += 1

            if remaining[skill_name] == 0:
                block_lines = _count_block_lines(skill_results[skill_name], args)
                renderer.flush_block(block_lines)
                total_pass, total_fail = _flush_skill_block(
                    skill_name, skill_results[skill_name],
                    args, total_pass, total_fail, results_all)
                if completed < total_cases:
                    renderer.update(completed)
            else:
                renderer.update(completed)
    except KeyboardInterrupt:
        renderer.interrupt(completed)
        for f in futures:
            f.cancel()
        executor.shutdown(wait=False, cancel_futures=True)
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(1)
    else:
        executor.shutdown(wait=True)

    renderer.clear()
    print(f"\n{'=' * 60}")
    print(f"Total: {C_GREEN}{total_pass} passed{C_RESET}, {C_RED}{total_fail} failed{C_RESET}")
    print(f"{'=' * 60}")

    if total_fail > 0:
        raise SkillctlError(f"{total_fail} test case(s) failed")


def cmd_help(args, parser=None):
    """Show detailed help with examples."""
    print(__doc__)

    sub_action = next(a for a in parser._actions if isinstance(a, argparse._SubParsersAction))

    print("COMMANDS\n")
    for name, sub in sub_action.choices.items():
        help_text = sub.format_help().split("\n")[0] or name
        func = sub.get_default("func")
        if func and func.__doc__:
            help_text = func.__doc__.strip().split("\n")[0]
        print(f"  {name:<30} {help_text}")

    print("\nARGUMENTS\n")
    seen = set()
    for name, sub in sub_action.choices.items():
        for act in sub._actions:
            if not act.option_strings or act.dest in seen or act.dest == "help":
                continue
            seen.add(act.dest)
            opts = ", ".join(act.option_strings)
            print(f"  {opts:<30} {act.help}")

    print("\nHARNESS TARGET PATHS\n")
    home = str(Path.home())
    cwd = str(Path.cwd())
    for agent, harness in HARNESS_PATHS.items():
        user_path = str(harness.user.skills).replace(home, "~")
        proj_path = str(harness.project.skills).replace(cwd, ".")
        print(f"  {agent:<10} user: {user_path:<30} project: {proj_path}")

    print("\nEXAMPLES\n")
    print("  skillctl list")
    print("  skillctl link --plugin coding --agent claude")
    print("  skillctl link --agent opencode")
    print("  skillctl link --plugin pm --agent claude --scope project")
    print("  skillctl unlink --plugin coding --agent claude")
    print("  skillctl unlink --agent claude")
    print("  skillctl prune --agent opencode")
    print("  skillctl prune --agent omp --apply --orphans")
    print("  skillctl doctor")
    print("  skillctl test")
    print("  skillctl test --skill open-pr")
    print("  skillctl test --jobs 8 --verbose")
    print("  skillctl test --runner claude --model claude-sonnet-4-20250514 --verbose")


def main():
    parser = argparse.ArgumentParser(
        prog="skillctl",
        description="Install, link, test, and diagnose agent skills.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # link
    p_link = sub.add_parser("link", help="Symlink a plugin's skills into a harness directory")
    p_link.add_argument("--plugin", help="Plugin name (coding, pm). Omit to link all plugins.")
    p_link.add_argument("--agent", required=True, help="Harness name (claude, codex, opencode, cursor, omp)")
    p_link.add_argument("--scope", choices=["user", "project"], default="user", help="User or project scope")
    p_link.add_argument("--copy", action="store_true", help="Copy instead of symlink (auto on Windows)")
    p_link.add_argument("--force", action="store_true", help="Overwrite existing targets (symlinks or copies)")
    p_link.set_defaults(func=cmd_link)

    # unlink
    p_unlink = sub.add_parser("unlink", help="Remove a plugin's skill symlinks from a harness directory")
    p_unlink.add_argument("--plugin", help="Plugin name. Omit to unlink all plugins.")
    p_unlink.add_argument("--agent", required=True, help="Harness name")
    p_unlink.add_argument("--scope", choices=["user", "project"], default="user", help="User or project scope")
    p_unlink.set_defaults(func=cmd_unlink)

    # doctor
    p_doctor = sub.add_parser("doctor", help="Report linked skills, orphans, and broken links")
    p_doctor.set_defaults(func=cmd_doctor)

    # prune
    p_prune = sub.add_parser("prune", help="Remove dangling links to deleted skills (dry run unless --apply)")
    p_prune.add_argument("--agent", required=True, help="Harness name (claude, codex, opencode, cursor, omp)")
    p_prune.add_argument("--scope", choices=["user", "project"], default="user", help="User or project scope")
    p_prune.add_argument("--apply", action="store_true", help="Remove stale links (default: dry run)")
    p_prune.add_argument("--orphans", action="store_true",
                         help="Also prune stale copies of removed skills (--apply still required)")
    p_prune.set_defaults(func=cmd_prune)

    # list
    p_list = sub.add_parser("list", help="List all plugins and their skills")
    p_list.set_defaults(func=cmd_list)

    # list-agents
    p_list_agents = sub.add_parser("list-agents", help="Print supported agent names, one per line")
    p_list_agents.set_defaults(func=cmd_list_agents)

    # test
    p_test = sub.add_parser("test", help="Run trigger detection tests for skills")
    p_test.add_argument("--skill", help="Test a single skill (by test directory name)")
    p_test.add_argument("--runner", default="opencode", choices=list(RUNNERS.keys()),
                        help="LLM runner to use: opencode, claude, or omp (default: opencode)")
    p_test.add_argument("--model", help="Model identifier (e.g. corti/corti-s1, claude-sonnet-4-20250514)")
    p_test.add_argument("--verbose", action="store_true", help="Show per-case details, not just failures")
    p_test.add_argument("--jobs", "-j", type=int, default=8,
                        help="Number of parallel LLM calls (default: 8)")
    p_test.set_defaults(func=cmd_test)

    # help
    p_help = sub.add_parser("help", help="Show detailed help with examples")
    p_help.set_defaults(func=cmd_help)

    args = parser.parse_args()
    try:
        if args.command == "help":
            cmd_help(args, parser)
        else:
            args.func(args)
    except SkillctlError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
