#!/usr/bin/env python3
"""Validate a skill with skills-ref, tolerating known harness-extension
frontmatter fields that the Agent Skills spec does not define.

skills-ref enforces the spec's field set; harnesses (Claude Code, Codex)
define additional top-level fields for invocation policy and read them at
runtime. Those fields are exempt from spec validation here — their semantics
belong to the harnesses, so we strip them for spec validation and do not
validate their values on the harnesses' behalf.
"""
import re
import pathlib
import yaml
import subprocess
import sys
import tempfile

# Fields the spec validator allows.
SPEC_FIELDS = {"allowed-tools", "compatibility", "description", "license", "metadata", "name"}
# Harness-extension fields exempt from spec validation, kept verbatim in the
# skill. Add fields here only when a harness defines them and reads them at
# runtime — their semantics are the harness's, not ours to validate.
HARNESS_EXTENSIONS = {"disable-model-invocation"}

FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---\n", re.S)


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: validate-skill <skill_dir>")
    skill_dir = pathlib.Path(sys.argv[1])
    text = (skill_dir / "SKILL.md").read_text()

    frontmatter = extract_frontmatter(text)
    if frontmatter is None:
        sys.exit(f"Validation failed for {skill_dir}: no frontmatter block")
    lines = frontmatter.splitlines()

    extra = get_unexpected_fields(frontmatter)
    if not extra:
        # Spec-legal frontmatter: validate the skill as-is.
        sys.exit(run_skills_ref_validate(str(skill_dir)))

    illegal = [k for k in extra if k not in HARNESS_EXTENSIONS]
    if illegal:
        sys.exit(
            f"Validation failed for {skill_dir}:\n"
            f"  - Unexpected fields in frontmatter: {', '.join(illegal)}"
        )

    # Only whitelisted harness extensions: validate a stripped copy.
    validate_stripped_copy(text, frontmatter, strip_harness_extensions(lines), skill_dir)


def extract_frontmatter(text):
    """Return the raw frontmatter block content, or None when absent."""
    m = FRONTMATTER_RE.match(text)
    return m.group(1) if m else None


def get_unexpected_fields(frontmatter):
    """Top-level frontmatter fields outside the spec's allowed set."""
    try:
        data = yaml.safe_load(frontmatter)
    except yaml.YAMLError:
        return []
    if not isinstance(data, dict):
        return []
    return [k for k in data if k not in SPEC_FIELDS]


def run_skills_ref_validate(path):
    """Run skills-ref validate on a path and return its exit code."""
    return subprocess.run(["skills-ref", "validate", path]).returncode


def strip_harness_extensions(lines):
    """Drop whitelisted extension fields, including indented continuations."""
    kept = []
    skipping = False
    for l in lines:
        if skipping:
            if l.startswith((" ", "\t")) or not l.strip():
                continue
            skipping = False
        if is_harness_extension(l):
            skipping = True
            continue
        kept.append(l)
    return kept


def is_harness_extension(line):
    """True when a frontmatter line declares a whitelisted harness extension."""
    key = line.split(":", 1)[0].strip()
    return key in HARNESS_EXTENSIONS and ":" in line


def validate_stripped_copy(text, frontmatter, kept_lines, skill_dir):
    """Validate a temp copy of the skill with harness extensions removed."""
    stripped = text.replace(frontmatter, "\n".join(kept_lines), 1)
    with tempfile.TemporaryDirectory() as tmp:
        copy_dir = pathlib.Path(tmp) / skill_dir.name
        copy_dir.mkdir()
        copy_dir.joinpath("SKILL.md").write_text(stripped)
        sys.exit(run_skills_ref_validate(str(copy_dir)))


if __name__ == "__main__":
    main()
